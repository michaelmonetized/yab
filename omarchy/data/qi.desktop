[Desktop Entry]
Type=Application
Name=Qi
GenericName=Web Browser
Comment=Keyboard-first, Omarchy-themed web browser
Exec=qi %U
Icon=qi
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=qi
Actions=new-window;

[Desktop Action new-window]
Name=New window
Exec=qi --new
