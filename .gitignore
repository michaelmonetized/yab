# Build output, build.sh regenerates all of this.
.build/
build/
.swiftpm/
*.xcuserstate
.DS_Store

# Signing material that's tied to one Apple Developer account and should
# never be committed, even though the scripts happily run without it.
*.provisionprofile
*.p12
*.mobileprovision

# Python bytecode from the scripts.
__pycache__/

# Yab for iPhone: what remote brings back from adhd, the project XcodeGen
# writes from Phone/project.yml, and the prototype kept beside it as a file.
Phone/.out/
Phone/*.xcodeproj
Phone/Reference/prototype.html
/evals/space-switching/grid
/evals/space-switching/board

# Local Chromium parity logs and downloaded CEF app artifacts.
/work/chromium-parity/
# Farm films and fetched eval worlds are local evidence, not source inputs.
/report/**/films/
/report/**/dense/
/report/**/measurements/
/report/after/matrix/boards/
/report/after/matrix/analysis.json
/report/after/matrix/matrix.json
/report/full/supplement/
/report/evals-*/
/report/base-*/
/report/after-sidebar-*/

# Keep the two committed reference frames available to farm snapshots.
!/report/final-short/matrix/films/
/report/final-short/matrix/films/*
!/report/final-short/matrix/films/row-own-site-dock-in-step+/
/report/final-short/matrix/films/row-own-site-dock-in-step+/*
!/report/final-short/matrix/films/row-own-site-dock-in-step+/030.png
!/report/final-short/matrix/films/row-own-site-dock-in-step+/160.png

# Farm job outputs fetched into a tree (./farm fetch JOB DEST) and any app
# bundle outside build/: evidence, never source.
/proofs*/
*.app/

# Completion signal remains readable after runner metadata is archived.
/codex-done

# Omaweb (omarchy/): Rust build output, editor and tool caches.
/target/
/omarchy/target/
**/*.rs.bk
.cache/
.direnv/
.vscode/
.idea/

# Never commit credentials or local secrets.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
credentials*.json
secrets*.toml
.netrc

# Omaweb app state if a dev run points XDG dirs into the tree.
/omarchy/.state/
*.sock
history.jsonl
session.json
/omarchy/.qmlls.ini
# Qt WebEngine profiles, caches and cookies if XDG dirs point into the tree,
# plus local config copies and dev-run logs/screenshots.
QtWebEngine/
Cookies
Cookies-journal
/omarchy/config.toml
/omarchy/*.log
/omarchy/nohup.out
# Omaweb state added with spaces, profiles and extensions (only if a dev run
# points XDG dirs into the tree): workspace, per-profile data, the password
# index, unpacked and imported extensions, blocklist caches, Chrome imports.
workspace.json
profiles.json
bookmarks.json
hidden.json
passwords.json
unpacked-extensions.json
disabled-extensions.json
extensions-src/
/omarchy/profiles/
blocklist.txt
/omarchy/lists/
Login Data
Login Data-journal
Local State
*.crx
